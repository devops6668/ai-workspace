# =============================================================================
# JupyterHub + jupyter-ai v3.x - K8s Optimized Build
# =============================================================================
# Optimized for Kubernetes with JupyterHub
# Smaller image size, security hardened
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="Paul Wong <paul@devops.local>"
LABEL description="JupyterHub single-user image with jupyter-ai v3.x for K8s"

# =============================================================================
# 1. System Dependencies (minimal)
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 2. Node.js (for ACP agents)
# =============================================================================
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 3. Create non-root user
# =============================================================================
RUN useradd -m -s /bin/bash jovyan \
    && mkdir -p /home/jovyan/.jupyter \
    && chown -R jovyan:jovyan /home/jovyan

# =============================================================================
# 4. Install Python Packages
# =============================================================================
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Core Jupyter + jupyter-ai v3.x
RUN pip install --no-cache-dir \
    jupyterlab>=4.0 \
    jupyterhub>=4.0 \
    "jupyter-ai[jupyternaut]>=3.0.0" \
    litellm>=1.0.0

# Data Science (optional - remove for lighter image)
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    scipy \
    scikit-learn \
    matplotlib \
    seaborn \
    plotly \
    pyarrow \
    openpyxl \
    requests \
    httpx \
    pydantic

# =============================================================================
# 5. Enable Extensions
# =============================================================================
RUN jupyter server extension enable jupyter_ai --py 2>/dev/null || true
RUN jupyter server extension enable jupyter_ai_litellm --py 2>/dev/null || true
RUN jupyter server extension enable jupyter_ai_jupyternaut --py 2>/dev/null || true

# =============================================================================
# 6. Environment Variables
# =============================================================================
ENV HOME=/home/jovyan \
    NB_USER=jovyan \
    NB_UID=1000 \
    NB_GID=100 \
    JUPYTER_ENABLE_LAB=yes \
    OPENAI_API_BASE="" \
    OPENAI_API_KEY=""

# =============================================================================
# 7. Switch to non-root user
# =============================================================================
USER jovyan
WORKDIR /home/jovyan

# =============================================================================
# 8. Health Check
# =============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8888/api || exit 1

# =============================================================================
# 9. Expose Port
# =============================================================================
EXPOSE 8888

# =============================================================================
# 10. Entrypoint
# =============================================================================
CMD ["jupyter-lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
